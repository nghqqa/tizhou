# 题舟官网部署配置模板（本地文件）
# 用法：cp .env.deploy.example .env.deploy，填入真实服务器信息后即可使用 deploy.sh 发布。
# 注意：.env.deploy 已被根目录 .gitignore 忽略（.env.* 模式），严禁把真实 IP/端口/账号提交到公开仓库。
DEPLOY_HOST=YOUR_SERVER_IP
DEPLOY_PORT=22
DEPLOY_USER=root
DEPLOY_TARGET=/var/www/tizhou-website
# 可选：指定 SSH 私钥路径，留空使用默认 ~/.ssh/id_*
DEPLOY_SSH_KEY=
# 可选：Nginx 302 跳转片段路径（设为 none 跳过同步）
DEPLOY_NGINX_REDIRECTS_FILE=/etc/nginx/snippets/tizhou-redirects.conf
# 可选：官网专属 Nginx 访问日志路径前缀（供 npm run website:stats 统计使用）
DEPLOY_ACCESS_LOG=/var/log/nginx/tizhou-website.access.log
